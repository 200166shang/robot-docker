# The default path is optimized for a mainland China network environment.
# Copy this file to .env to customize the values for the local machine.
SOURCE_MODE=mirror

BASE_IMAGE=ros:jazzy-ros-base
ROS_DISTRO=jazzy
IMAGE_NAME=robot-docker:jazzy-base
ROS_DOMAIN_ID=0
WORKSPACE_DIR=.

# Ubuntu APT mirrors. The image selects one according to the container
# architecture reported by dpkg: amd64 or arm64.
UBUNTU_MIRROR_AMD64=https://mirrors.tuna.tsinghua.edu.cn/ubuntu
UBUNTU_MIRROR_ARM64=https://mirrors.tuna.tsinghua.edu.cn/ubuntu-ports

# ROS 2 APT mirror and rosdep rosdistro index mirror.
ROS_APT_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/ros2/ubuntu
ROSDISTRO_INDEX_URL=https://mirrors.tuna.tsinghua.edu.cn/rosdistro/index-v4.yaml
ROSDEP_SOURCE_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/github-raw/ros/rosdistro/master
